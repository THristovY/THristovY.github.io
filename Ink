import streamlit as st
import pandas as pd
import plotly.express as px
from datetime import date
import io

st.set_page_config(page_title="Personal Finance Tracker", layout="wide")
st.title("💰 Personal Finance Tracker")

# Initialize or load data
if "transactions" not in st.session_state:
    st.session_state.transactions = pd.DataFrame(
        columns=["Date", "Type", "Category", "Amount", "Description"]
    )

# Sidebar: Add transaction
st.sidebar.header("➕ Add Transaction")
trans_date = st.sidebar.date_input("Date", value=date.today())
trans_type = st.sidebar.selectbox("Type", ["Income", "Expense"])
categories = ["Salary", "Freelance", "Food", "Transport", "Housing", "Utilities",
              "Entertainment", "Shopping", "Health", "Other"]
category = st.sidebar.selectbox("Category", categories + ["Custom"])
if category == "Custom":
    category = st.sidebar.text_input("Custom category")
amount = st.sidebar.number_input("Amount", min_value=0.01, value=10.0, step=0.01)
description = st.sidebar.text_input("Description (optional)")

if st.sidebar.button("Add Transaction", type="primary"):
    if category.strip():
        new_row = pd.DataFrame([{
            "Date": trans_date,
            "Type": trans_type,
            "Category": category.strip(),
            "Amount": float(amount),
            "Description": description.strip()
        }])
        st.session_state.transactions = pd.concat(
            [st.session_state.transactions, new_row], ignore_index=True
        )
        st.sidebar.success("Transaction added!")
        st.rerun()
    else:
        st.sidebar.error("Please enter a category.")

# Sidebar: Data management
st.sidebar.header("📁 Data")
uploaded = st.sidebar.file_uploader("Load CSV", type="csv")
if uploaded:
    try:
        loaded = pd.read_csv(uploaded)
        required = {"Date", "Type", "Category", "Amount", "Description"}
        if required.issubset(loaded.columns):
            st.session_state.transactions = loaded
            st.sidebar.success("Data loaded!")
            st.rerun()
        else:
            st.sidebar.error("CSV missing required columns.")
    except Exception as e:
        st.sidebar.error(f"Error loading file: {e}")

if not st.session_state.transactions.empty:
    csv_buffer = io.StringIO()
    st.session_state.transactions.to_csv(csv_buffer, index=False)
    st.sidebar.download_button(
        label="Download CSV",
        data=csv_buffer.getvalue(),
        file_name="finance_data.csv",
        mime="text/csv"
    )

if st.sidebar.button("Clear All Data", type="secondary"):
    st.session_state.transactions = pd.DataFrame(
        columns=["Date", "Type", "Category", "Amount", "Description"]
    )
    st.sidebar.success("All data cleared.")
    st.rerun()

# Main view
df = st.session_state.transactions.copy()

if df.empty:
    st.info("No transactions yet. Add some using the sidebar!")
else:
    # Convert date for better display/filtering
    df["Date"] = pd.to_datetime(df["Date"]).dt.date

    # Summary metrics
    income = df.loc[df["Type"] == "Income", "Amount"].sum()
    expenses = df.loc[df["Type"] == "Expense", "Amount"].sum()
    balance = income - expenses

    col1, col2, col3 = st.columns(3)
    col1.metric("Total Income", f"${income:,.2f}")
    col2.metric("Total Expenses", f"${expenses:,.2f}")
    col3.metric("Balance", f"${balance:,.2f}",
                delta=f"${balance:,.2f}" if balance >= 0 else None)

    # Transactions table
    st.subheader("📋 Transactions")
    st.dataframe(df.sort_values("Date", ascending=False), use_container_width=True)

    # Charts
    st.subheader("📊 Insights")
    col_a, col_b = st.columns(2)

    expenses_df = df[df["Type"] == "Expense"]
    if not expenses_df.empty:
        with col_a:
            fig_pie = px.pie(expenses_df, values="Amount", names="Category",
                             title="Expenses by Category")
            st.plotly_chart(fig_pie, use_container_width=True)

        with col_b:
            monthly = df.copy()
            monthly["Month"] = pd.to_datetime(monthly["Date"]).dt.to_period("M").astype(str)
            monthly_summary = monthly.groupby(["Month", "Type"])["Amount"].sum().unstack(fill_value=0)
            fig_bar = px.bar(monthly_summary.reset_index(), x="Month",
                             y=["Income", "Expense"] if "Expense" in monthly_summary.columns else ["Income"],
                             title="Monthly Income vs Expenses", barmode="group")
            st.plotly_chart(fig_bar, use_container_width=True)
    else:
        st.info("Add some expenses to see charts.")

st.caption("This is a local personal tool. Not financial advice. Keep your CSV backups safe.")
