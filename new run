import streamlit as st
import pandas as pd
import yfinance as yf
import plotly.express as px
from pathlib import Path
from datetime import datetime

# -----------------------------
# Configuration
# -----------------------------
DATA_FILE = Path("portfolio.csv")
st.set_page_config(page_title="Portfolio Tracker", page_icon="📈", layout="wide")

# -----------------------------
# Helper functions
# -----------------------------
def load_portfolio():
    if DATA_FILE.exists():
        return pd.read_csv(DATA_FILE)
    return pd.DataFrame(columns=["Ticker", "Shares", "Avg Cost", "Added"])

def save_portfolio(df):
    df.to_csv(DATA_FILE, index=False)

def get_current_prices(tickers):
    """Fetch latest prices. Works for stocks and major crypto (BTC-USD, ETH-USD…)."""
    if not tickers:
        return {}
    data = yf.download(tickers, period="1d", progress=False, threads=True)
    if len(tickers) == 1:
        # single ticker returns Series
        price = data["Close"].iloc[-1]
        return {tickers[0]: float(price) if not pd.isna(price) else None}
    else:
        prices = data["Close"].iloc[-1]
        return {t: float(prices[t]) if not pd.isna(prices[t]) else None for t in tickers}

# -----------------------------
# Sidebar – Add / Manage holdings
# -----------------------------
st.sidebar.title("Portfolio Manager")

df = load_portfolio()

with st.sidebar.form("add_holding", clear_on_submit=True):
    st.subheader("Add new holding")
    ticker = st.text_input("Ticker (e.g. AAPL, BTC-USD, TSLA)").upper().strip()
    shares = st.number_input("Number of shares / units", min_value=0.0, step=0.0001, format="%.4f")
    avg_cost = st.number_input("Average cost per share ($)", min_value=0.0, step=0.01, format="%.2f")
    submitted = st.form_submit_button("Add to portfolio")

    if submitted and ticker and shares > 0 and avg_cost > 0:
        new_row = pd.DataFrame([{
            "Ticker": ticker,
            "Shares": shares,
            "Avg Cost": avg_cost,
            "Added": datetime.now().strftime("%Y-%m-%d %H:%M")
        }])
        df = pd.concat([df, new_row], ignore_index=True)
        save_portfolio(df)
        st.success(f"Added {shares} {ticker}")
        st.rerun()

# Delete holdings
if not df.empty:
    st.sidebar.subheader("Remove holding")
    to_delete = st.sidebar.selectbox("Select ticker to remove", options=df["Ticker"].unique())
    if st.sidebar.button("Delete selected"):
        df = df[df["Ticker"] != to_delete]
        save_portfolio(df)
        st.sidebar.success(f"Removed {to_delete}")
        st.rerun()

# -----------------------------
# Main dashboard
# -----------------------------
st.title("📈 Portfolio Tracker")

if df.empty:
    st.info("Your portfolio is empty. Add some holdings using the sidebar →")
    st.stop()

# Fetch live prices
tickers = df["Ticker"].tolist()
prices = get_current_prices(tickers)

# Build enriched dataframe
df["Current Price"] = df["Ticker"].map(prices)
df["Market Value"] = df["Shares"] * df["Current Price"]
df["Cost Basis"] = df["Shares"] * df["Avg Cost"]
df["Unrealized P/L"] = df["Market Value"] - df["Cost Basis"]
df["Return %"] = (df["Unrealized P/L"] / df["Cost Basis"] * 100).round(2)

# Totals
total_value = df["Market Value"].sum()
total_cost = df["Cost Basis"].sum()
total_pl = total_value - total_cost
total_return = (total_pl / total_cost * 100) if total_cost > 0 else 0

# KPI cards
col1, col2, col3, col4 = st.columns(4)
col1.metric("Total Value", f"${total_value:,.2f}")
col2.metric("Total Cost", f"${total_cost:,.2f}")
col3.metric("Unrealized P/L", f"${total_pl:,.2f}", delta=f"{total_return:.2f}%")
col4.metric("Holdings", len(df))

st.divider()

# Holdings table
st.subheader("Holdings")
display_df = df[[
    "Ticker", "Shares", "Avg Cost", "Current Price",
    "Market Value", "Unrealized P/L", "Return %"
]].copy()
display_df = display_df.round(2)
st.dataframe(
    display_df.style.format({
        "Shares": "{:.4f}",
        "Avg Cost": "${:.2f}",
        "Current Price": "${:.2f}",
        "Market Value": "${:.2f}",
        "Unrealized P/L": "${:.2f}",
        "Return %": "{:.2f}%"
    }),
    use_container_width=True,
    hide_index=True
)

# Allocation pie chart
st.subheader("Portfolio Allocation")
fig = px.pie(
    df,
    values="Market Value",
    names="Ticker",
    title="Market Value by Holding",
    hole=0.4
)
fig.update_traces(textposition="inside", textinfo="percent+label")
st.plotly_chart(fig, use_container_width=True)

# Optional: download data
csv = df.to_csv(index=False).encode("utf-8")
st.download_button(
    label="Download portfolio as CSV",
    data=csv,
    file_name="my_portfolio.csv",
    mime="text/csv"
)
