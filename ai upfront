<!DOCTYPE html>
<html>
<head>
  <title>Basic Movie Player</title>
  <style>
    body {
      background: #111;
      display: flex;
      justify-content: center;
      align-items: center;
      height: 100vh;
      margin: 0;
      font-family: Arial, sans-serif;
    }
    video {
      max-width: 90%;
      max-height: 90%;
      border-radius: 8px;
      box-shadow: 0 0 20px rgba(0,0,0,0.5);
    }
  </style>
</head>
<body>
  <video controls width="800">
    <source src="your-movie.mp4" type="video/mp4">
    Your browser does not support the video tag.
  </video>
</body>
</html>
